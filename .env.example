# --- Barato.ar env vars (F01 · C-005/C-008/C-009/C-010/C-012) ---
# Copiá este archivo a .env.local y completá los valores.
# NUNCA commitees .env.local ni ningún archivo con secretos reales.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database (Neon Postgres) ---
# Pooled (para runtime Next.js)
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/barato?sslmode=require"
# Unpooled (para migraciones Prisma)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/barato?sslmode=require"

# --- Auth.js v5 (C-010) ---
# Generar: openssl rand -base64 32
AUTH_SECRET="replace-me-with-random-32-bytes"
AUTH_URL=http://localhost:3000
# Emails autorizados a /admin, CSV
ADMIN_EMAILS=you@example.com

# --- Resend (email para Auth.js magic link + F09 alertas) ---
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"

# --- On-demand revalidation (C-008) ---
# Header x-revalidate-secret que el runner de ingesta envía al finalizar
REVALIDATE_SECRET="replace-me-with-random-32-bytes"

# --- Cloudflare R2 (C-009) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_PRODUCTS="barato-ar-products"
R2_BUCKET_REPORTS="barato-ar-reports"
# CDN público apuntando al bucket products (custom domain en R2)
NEXT_PUBLIC_R2_PUBLIC_URL="https://img.barato.ar"

# --- Observabilidad ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- Analytics privacy-first ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="barato.ar"

# --- Redis (Upstash) — F06+ ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
