# Barato.ar · line endings normalization

# Default: auto-detect text
*                    text=auto

# Explicitly LF for shell/CI/docker (rompe si CRLF en Linux/Alpine)
*.sh                 text eol=lf
Dockerfile           text eol=lf
docker/*             text eol=lf
*.yml                text eol=lf
*.yaml               text eol=lf
.env*                text eol=lf

# Binary
*.png                binary
*.jpg                binary
*.jpeg               binary
*.webp               binary
*.pdf                binary
*.ico                binary
