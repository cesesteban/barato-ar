{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3900/",
        "http://localhost:3900/ofertas",
        "http://localhost:3900/producto/coca-cola-original-2-25l-retornable",
        "http://localhost:3900/buscar?q=coca",
        "http://localhost:3900/reportar",
        "http://localhost:3900/sobre"
      ],
      "numberOfRuns": 2,
      "startServerCommand": "docker compose up -d",
      "startServerReadyPattern": "Ready in"
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 3000 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 400 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
