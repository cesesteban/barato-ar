# Copia .env.docker.example → .env.local para desarrollo con `pnpm dev`
# apuntando a los servicios Docker (db/redis/mailpit corriendo en localhost).
# Los servicios internos usan sus nombres de red (`db`, `redis`), pero desde
# tu máquina host mapean a los puertos elegidos abajo.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3900
NODE_ENV=development

# --- Database (Postgres en Docker, puerto 5434) ---
DATABASE_URL=postgresql://barato:barato_dev_password@localhost:5434/barato
DATABASE_URL_UNPOOLED=postgresql://barato:barato_dev_password@localhost:5434/barato

# --- Auth.js ---
AUTH_SECRET=dev-secret-please-change-me-1234567890abcdef
AUTH_URL=http://localhost:3900
ADMIN_EMAILS=admin@barato.ar

# --- Resend (para tests locales, usá MailPit con SMTP genérico en lugar de Resend) ---
RESEND_API_KEY=

# --- On-demand revalidation ---
REVALIDATE_SECRET=dev-revalidate-secret-16b

# --- Cloudflare R2 (opcional en dev; deja vacío) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRODUCTS=barato-ar-products
R2_BUCKET_REPORTS=barato-ar-reports
NEXT_PUBLIC_R2_PUBLIC_URL=

# --- Observabilidad ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Analytics (opcional en dev) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Redis (dejá vacío en dev; se usa el stub in-memory de src/lib/redis.ts) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- SEPA / Precios Claros ---
SEPA_MANIFEST_URL=
