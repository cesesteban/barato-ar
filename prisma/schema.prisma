// Barato.ar — schema del core.
// Columnas mapeadas a snake_case para SQL raw estándar; tablas mapeadas también.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_URL_UNPOOLED")
  extensions = [pg_trgm, vector]
}

// ============================================================================
// AppMeta (F001)
// ============================================================================

model AppMeta {
  id        Int      @id @default(1)
  version   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("app_meta")
}

// ============================================================================
// Auth.js v5 (F001 · C-010)
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// Dominio · Ofertas y precios (F003)
// ============================================================================

enum Vertical {
  supermarket
  delivery
  pharmacy
  beverages
}

enum PriceSource {
  flyer
  precios_claros
  public_api
  crowdsourced
  scraped
}

enum PromoType {
  unit
  nx1
  nxm
  second_off
  bundle_discount
}

enum IngestionStatus {
  running
  success
  partial
  failed
}

model Chain {
  id         String   @id
  name       String
  slug       String   @unique
  vertical   Vertical @default(supermarket)
  logoUrl    String?  @map("logo_url")
  websiteUrl String?  @map("website_url")
  createdAt  DateTime @default(now()) @map("created_at")

  stores Store[]
  offers Offer[]
  runs   IngestionRun[]

  @@map("chains")
}

model Zone {
  id       String  @id
  name     String
  slug     String  @unique
  parentId String? @map("parent_id")
  lat      Float?
  lng      Float?
  radiusKm Float?  @map("radius_km")

  parent   Zone?   @relation("ZoneParent", fields: [parentId], references: [id])
  children Zone[]  @relation("ZoneParent")
  stores   Store[]

  @@map("zones")
}

model Store {
  id        String   @id @default(cuid())
  chainId   String   @map("chain_id")
  name      String
  slug      String   @unique
  address   String?
  zoneId    String?  @map("zone_id")
  lat       Float?
  lng       Float?
  isVirtual Boolean  @default(false) @map("is_virtual")
  createdAt DateTime @default(now()) @map("created_at")

  chain  Chain   @relation(fields: [chainId], references: [id])
  zone   Zone?   @relation(fields: [zoneId], references: [id])
  prices Price[]

  @@index([chainId, zoneId])
  @@map("stores")
}

model Product {
  id              String    @id @default(cuid())
  name            String
  normalizedName  String    @map("normalized_name")
  brand           String?
  size            Float?
  unit            String?
  standardSize    Decimal?  @db.Decimal(10, 4) @map("standard_size")
  standardUnit    String?   @map("standard_unit")
  packagingFlag   String?   @map("packaging_flag")
  category        String?
  imageUrl        String?   @map("image_url")
  imageSourceUrl  String?   @map("image_source_url")
  imageStatus     String?   @map("image_status")
  imageCapturedAt DateTime? @map("image_captured_at")
  eanCode         String?   @unique @map("ean_code")
  slug            String    @unique
  canonicalId     String?   @map("canonical_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  canonical Product?       @relation("CanonicalProduct", fields: [canonicalId], references: [id])
  aliases   Product[]      @relation("CanonicalProduct")
  prices    Price[]
  offers    Offer[]
  history   PriceHistory[]
  alerts    Alert[]

  @@index([normalizedName])
  @@index([brand])
  @@index([category])
  @@index([standardUnit, standardSize])
  @@index([canonicalId])
  @@map("products")
}

model Price {
  id              String      @id @default(cuid())
  productId       String      @map("product_id")
  storeId         String      @map("store_id")
  price           Decimal     @db.Decimal(10, 2)
  previousPrice   Decimal?    @db.Decimal(10, 2) @map("previous_price")
  currency        String      @default("ARS")
  isOffer         Boolean     @default(false) @map("is_offer")
  discountPct     Float?      @map("discount_pct")
  validFrom       DateTime    @map("valid_from")
  validTo         DateTime?   @map("valid_to")
  source          PriceSource
  sourceUrl       String?     @map("source_url")
  storeProductUrl String?     @map("store_product_url")
  capturedAt      DateTime    @default(now()) @map("captured_at")

  promoType              PromoType @default(unit) @map("promo_type")
  promoBuyQty            Int?      @map("promo_buy_qty")
  promoPayQty            Int?      @map("promo_pay_qty")
  promoSecondDiscountPct Float?    @map("promo_second_discount_pct")
  promoDescription       String?   @map("promo_description")

  pricePerUnit    Decimal? @db.Decimal(10, 4) @map("price_per_unit")
  pricePerUnitEff Decimal? @db.Decimal(10, 4) @map("price_per_unit_eff")

  upvotesCache Int @default(0) @map("upvotes_cache")

  product Product @relation(fields: [productId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@unique([productId, storeId, source, validFrom], name: "unique_capture")
  @@index([storeId, capturedAt])
  @@index([productId, capturedAt])
  @@index([pricePerUnitEff])
  @@map("prices")
}

model PriceHistory {
  id         BigInt   @id @default(autoincrement())
  productId  String   @map("product_id")
  storeId    String   @map("store_id")
  price      Decimal  @db.Decimal(10, 2)
  capturedAt DateTime @default(now()) @map("captured_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, storeId, capturedAt])
  @@map("price_history")
}

model Offer {
  id          String    @id @default(cuid())
  title       String
  description String?
  productId   String?   @map("product_id")
  chainId     String    @map("chain_id")
  discountPct Float?    @map("discount_pct")
  badge       String?
  validFrom   DateTime  @map("valid_from")
  validTo     DateTime? @map("valid_to")
  sourceUrl   String?   @map("source_url")
  upvotes     Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")

  product Product? @relation(fields: [productId], references: [id])
  chain   Chain    @relation(fields: [chainId], references: [id])

  @@index([chainId, validTo])
  @@map("offers")
}

// ============================================================================
// Alertas de precio (F009)
// ============================================================================

enum AlertStatus {
  pending
  active
  notified
  cancelled
  bounced
}

model Alert {
  id              String      @id @default(cuid())
  email           String
  productId       String      @map("product_id")
  targetPrice     Decimal     @db.Decimal(10, 2) @map("target_price")
  zoneSlug        String      @map("zone_slug")
  status          AlertStatus @default(pending)
  verifyTokenHash String      @unique @map("verify_token_hash")
  unsubTokenHash  String      @unique @map("unsub_token_hash")
  verifiedAt      DateTime?   @map("verified_at")
  notifiedAt      DateTime?   @map("notified_at")
  cancelledAt     DateTime?   @map("cancelled_at")
  ipHash          String?     @map("ip_hash")
  createdAt       DateTime    @default(now()) @map("created_at")
  expiresAt       DateTime    @map("expires_at")

  product Product      @relation(fields: [productId], references: [id])
  events  EmailEvent[]

  @@unique([email, productId, targetPrice])
  @@index([status, verifiedAt])
  @@index([email])
  @@map("alerts")
}

model EmailEvent {
  id       BigInt   @id @default(autoincrement())
  alertId  String   @map("alert_id")
  kind     String
  metadata Json?
  ts       DateTime @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, ts])
  @@map("email_events")
}

// ============================================================================
// Community reports (F011 · crowdsourcing)
// ============================================================================

enum ReportStatus {
  pending
  approved
  rejected
  auto_hidden
  re_review
}

model Report {
  id             String       @id @default(cuid())
  productSlug    String?      @map("product_slug")
  productText    String?      @map("product_text")
  chainSlug      String       @map("chain_slug")
  storeText      String?      @map("store_text")
  storeId        String?      @map("store_id")
  price          Decimal      @db.Decimal(10, 2)
  previousPrice  Decimal?     @db.Decimal(10, 2) @map("previous_price")
  validTo        DateTime?    @map("valid_to")
  photoUrl       String?      @map("photo_url")
  photoBlobKey   String?      @map("photo_blob_key")
  description    String?      @db.Text
  ipHash         String       @map("ip_hash")
  status         ReportStatus @default(pending)
  reasonRejected String?      @map("reason_rejected")
  approvedBy     String?      @map("approved_by")
  approvedAt     DateTime?    @map("approved_at")
  purgedAt       DateTime?    @map("purged_at")
  upvotes        Int          @default(0)
  downvotes      Int          @default(0)
  createdAt      DateTime     @default(now()) @map("created_at")

  votes ReportVote[]

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
  @@map("reports")
}

model ReportVote {
  id        String   @id @default(cuid())
  reportId  String   @map("report_id")
  ipHash    String   @map("ip_hash")
  kind      String
  createdAt DateTime @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, ipHash])
  @@index([reportId, kind])
  @@map("report_votes")
}

model SearchLog {
  id               BigInt   @id @default(autoincrement())
  query            String
  zoneSlug         String?  @map("zone_slug")
  resultsCount     Int      @map("results_count")
  clickedProductId String?  @map("clicked_product_id")
  ipHash           String?  @map("ip_hash")
  ts               DateTime @default(now())

  @@index([query, ts])
  @@map("search_logs")
}

// ============================================================================
// Normalizer (F005 · C-001..C-006)
// ============================================================================

model NormalizerCandidate {
  id         String    @id @default(cuid())
  productAId String    @map("product_a_id")
  productBId String    @map("product_b_id")
  confidence Float
  features   Json
  status     String    @default("pending")
  decidedBy  String?   @map("decided_by")
  decidedAt  DateTime? @map("decided_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([productAId, productBId])
  @@index([status, confidence])
  @@map("normalizer_candidates")
}

model NormalizerReject {
  id         String   @id @default(cuid())
  productAId String   @map("product_a_id")
  productBId String   @map("product_b_id")
  reason     String?
  rejectedBy String   @map("rejected_by")
  rejectedAt DateTime @default(now()) @map("rejected_at")

  @@unique([productAId, productBId])
  @@map("normalizer_rejects")
}

model IngestionRun {
  id           String          @id @default(cuid())
  chainId      String          @map("chain_id")
  source       PriceSource
  startedAt    DateTime        @default(now()) @map("started_at")
  finishedAt   DateTime?       @map("finished_at")
  status       IngestionStatus @default(running)
  rowsIngested Int             @default(0) @map("rows_ingested")
  rowsSkipped  Int             @default(0) @map("rows_skipped")
  errorMessage String?         @map("error_message")
  metadata     Json?

  chain Chain @relation(fields: [chainId], references: [id])

  @@index([chainId, startedAt])
  @@map("ingestion_runs")
}
