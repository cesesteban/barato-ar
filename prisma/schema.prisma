// Barato.ar — schema del core (Feature 003).
// Incluye Auth.js tables (C-010) + dominio completo con clarifications C-001..C-006.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_URL_UNPOOLED")
  extensions = [pg_trgm, pgvector]
}

// ============================================================================
// AppMeta (F001)
// ============================================================================

model AppMeta {
  id        Int      @id @default(1)
  version   String
  createdAt DateTime @default(now())

  @@map("app_meta")
}

// ============================================================================
// Auth.js v5 (F001 · C-010)
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// Dominio · Ofertas y precios (F003)
// ============================================================================

enum Vertical {
  supermarket
  delivery
  pharmacy
  beverages
}

enum PriceSource {
  flyer
  precios_claros
  public_api
  crowdsourced
  scraped
}

enum PromoType {
  unit // C-001: precio simple
  nx1 // 2x1, 3x1
  nxm // 3x2
  second_off // 2do al 70%
  bundle_discount // 3 iguales 20%
}

enum IngestionStatus {
  running
  success
  partial
  failed
}

model Chain {
  id         String   @id
  name       String
  slug       String   @unique
  vertical   Vertical @default(supermarket)
  logoUrl    String?
  websiteUrl String?
  createdAt  DateTime @default(now())

  stores Store[]
  offers Offer[]
  runs   IngestionRun[]

  @@map("chains")
}

model Zone {
  id       String  @id
  name     String
  slug     String  @unique
  parentId String?
  lat      Float?
  lng      Float?
  radiusKm Float?

  parent   Zone?   @relation("ZoneParent", fields: [parentId], references: [id])
  children Zone[]  @relation("ZoneParent")
  stores   Store[]

  @@map("zones")
}

model Store {
  id        String   @id @default(cuid())
  chainId   String
  name      String
  slug      String   @unique
  address   String?
  zoneId    String?
  lat       Float?
  lng       Float?
  isVirtual Boolean  @default(false)
  createdAt DateTime @default(now())

  chain  Chain   @relation(fields: [chainId], references: [id])
  zone   Zone?   @relation(fields: [zoneId], references: [id])
  prices Price[]

  @@index([chainId, zoneId])
  @@map("stores")
}

model Product {
  id              String    @id @default(cuid())
  name            String
  normalizedName  String
  brand           String?
  size            Float?
  unit            String?
  standardSize    Decimal?  @db.Decimal(10, 4) // C-003
  standardUnit    String? // C-003
  packagingFlag   String? // C-004
  category        String?
  imageUrl        String? // C-006
  imageSourceUrl  String? // C-006 auditoría
  imageStatus     String? // ok | missing | failed | placeholder
  imageCapturedAt DateTime?
  eanCode         String?   @unique
  slug            String    @unique
  canonicalId     String? // F005
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  canonical Product?       @relation("CanonicalProduct", fields: [canonicalId], references: [id])
  aliases   Product[]      @relation("CanonicalProduct")
  prices    Price[]
  offers    Offer[]
  history   PriceHistory[]

  @@index([normalizedName])
  @@index([brand])
  @@index([category])
  @@index([standardUnit, standardSize])
  @@index([canonicalId])
  @@map("products")
}

model Price {
  id              String      @id @default(cuid())
  productId       String
  storeId         String
  price           Decimal     @db.Decimal(10, 2)
  previousPrice   Decimal?    @db.Decimal(10, 2)
  currency        String      @default("ARS")
  isOffer         Boolean     @default(false)
  discountPct     Float?
  validFrom       DateTime
  validTo         DateTime?
  source          PriceSource
  sourceUrl       String?
  storeProductUrl String? // C-006 deep link al PDP
  capturedAt      DateTime    @default(now())

  // C-001 — combos
  promoType              PromoType @default(unit)
  promoBuyQty            Int?
  promoPayQty            Int?
  promoSecondDiscountPct Float?
  promoDescription       String?

  // C-003 — precio por unidad
  pricePerUnit    Decimal? @db.Decimal(10, 4)
  pricePerUnitEff Decimal? @db.Decimal(10, 4)

  // F008 caché para ranking
  upvotesCache Int @default(0)

  product Product @relation(fields: [productId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@unique([productId, storeId, source, validFrom], name: "unique_capture")
  @@index([storeId, capturedAt])
  @@index([productId, capturedAt])
  @@index([pricePerUnitEff])
  @@map("prices")
}

model PriceHistory {
  id         BigInt   @id @default(autoincrement())
  productId  String
  storeId    String
  price      Decimal  @db.Decimal(10, 2)
  capturedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, storeId, capturedAt])
  @@map("price_history")
}

model Offer {
  id          String    @id @default(cuid())
  title       String
  description String?
  productId   String?
  chainId     String
  discountPct Float?
  badge       String?
  validFrom   DateTime
  validTo     DateTime?
  sourceUrl   String?
  upvotes     Int       @default(0)
  createdAt   DateTime  @default(now())

  product Product? @relation(fields: [productId], references: [id])
  chain   Chain    @relation(fields: [chainId], references: [id])

  @@index([chainId, validTo])
  @@map("offers")
}

// ============================================================================
// Normalizer (F005 · C-001..C-006)
// ============================================================================

model NormalizerCandidate {
  id         String   @id @default(cuid())
  productAId String
  productBId String
  confidence Float
  features   Json
  status     String   @default("pending") // pending | approved | rejected
  decidedBy  String?
  decidedAt  DateTime?
  createdAt  DateTime @default(now())

  @@unique([productAId, productBId])
  @@index([status, confidence])
  @@map("normalizer_candidates")
}

model NormalizerReject {
  id         String   @id @default(cuid())
  productAId String
  productBId String
  reason     String?
  rejectedBy String
  rejectedAt DateTime @default(now())

  @@unique([productAId, productBId])
  @@map("normalizer_rejects")
}

model SearchLog {
  id               BigInt   @id @default(autoincrement())
  query            String
  zoneSlug         String?
  resultsCount     Int
  clickedProductId String?
  ipHash           String?
  ts               DateTime @default(now())

  @@index([query, ts])
  @@map("search_logs")
}

model IngestionRun {
  id           String          @id @default(cuid())
  chainId      String
  source       PriceSource
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  status       IngestionStatus @default(running)
  rowsIngested Int             @default(0)
  rowsSkipped  Int             @default(0)
  errorMessage String?
  metadata     Json?

  chain Chain @relation(fields: [chainId], references: [id])

  @@index([chainId, startedAt])
  @@map("ingestion_runs")
}
